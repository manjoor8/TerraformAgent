# ---- Core -------------------------------------------------------------
APP_NAME=TerraformAgent
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///D:/Code/TerraformAgent/backend/data/terraformagent.db
ARTIFACT_ROOT=D:/Code/TerraformAgent/backend/data/artifacts
WORKSPACE_ROOT=D:/Code/TerraformAgent/backend/data/workspaces
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Local bootstrap administrator -----------------------------------
BOOTSTRAP_EMAIL=admin@terraformagent.local
BOOTSTRAP_PASSWORD=ChangeMe123!
BOOTSTRAP_ORG=TerraformAgent
# Extra platform admins allowed to configure the LLM provider (comma-separated).
PLATFORM_ADMIN_EMAILS=

# ---- LLM (optional) ---------------------------------------------------
# auto | openai | azure_openai | deepseek | offline
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Terraform --------------------------------------------------------
TERRAFORM_BINARY=terraform
TERRAFORM_PLUGIN_CACHE_DIR=D:/Code/TerraformAgent/backend/data/plugin-cache
TERRAFORM_TIMEOUT_SECONDS=600
TERRAFORM_APPLY_TIMEOUT_SECONDS=3600
# Optional external scanners; built-in deterministic policy always runs.
TFLINT_BINARY=tflint
CHECKOV_BINARY=checkov
LIVE_PRICING=false

# ---- Azure credentials (worker only, NEVER commit) --------------------
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=
# ARM_TENANT_ID=
# ARM_SUBSCRIPTION_ID=
# ARM_USE_OIDC=false
# ARM_USE_MSI=false
